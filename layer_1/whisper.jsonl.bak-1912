{"video_id": "K01_V001", "seg_id": "K01_V001_000000", "start_ms": 3600, "end_ms": 10500, "text": "kính chào quý vị đây là chương trình sáu mươi giờ chiều thứ ba của đài truyền hình thành phố hồ chí minh và chương trình hôm nay ngày một tháng mười sẽ có những nội dung chính sau đây."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000001", "start_ms": 14400, "end_ms": 15700, "text": "lũ gân sạt lở."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000002", "start_ms": 16100, "end_ms": 19200, "text": "cô lập hoàn toàn bốn bảng khẩn trương khắc phục hậu quả sôi nổ."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000003", "start_ms": 19700, "end_ms": 24000, "text": "phụ giáo viên xin tiền hỗ trợ mua máy tính cá nhân học sinh đã trở lại trường sáng nay."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000004", "start_ms": 24900, "end_ms": 29700, "text": "ông shigeru ishiba chính thức trở thành tân thủ tướng nhật bản."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000005", "start_ms": 32000, "end_ms": 48100, "text": "thưa quý vị theo trung tâm dự báo khí tượng thủy văn quốc gia lúc mười ba giờ chiều nay ngày một tháng mười vị trí siêu bão ra thôn ở trên vùng biển phía đông bắc của khu vực bắc biển đông sức gió mạnh nhất vùng gần tâm bão mạnh cấp mười sáu một trăm tám bốn đến hai trăm lẻ một ki lô mét trên một giờ giật trên cấp mười bảy."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000006", "start_ms": 48100, "end_ms": 74100, "text": "dự báo trong hai mươi bốn giờ tới sưa bão cờ ro thông đổi hướng và di chuyển theo hướng bắc đông bắc với tốc độ khoảng năm ki lô mét trên một giờ do ảnh hưởng bão đêm qua và sáng nay khu vực tây bắc việt bắc thanh hoá và nghệ an đã có mưa vừa mưa to cục bộ có nơi mưa rất to tối qua tại huyện tương dương tỉnh nghệ an đã bất ngờ xảy ra lũ ống lũ quét khiến nhiều bản làng ngập nước thiệt hại nặng trong đêm tối hàng trăm người dân giáo viên học sinh vất vả chạy lũ."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000007", "start_ms": 76300, "end_ms": 97900, "text": "trận lũ ống bất ngờ xảy ra vào khoảng hơn hai mươi hai giờ đêm ba mươi tháng chín tại xã lượng minh huyện tương dương một số nhà cửa trường học ngập nước nhiều tài sản đồ đạc bị cuốn trôi thiệt hại người dân địa phương và chính quyền xã đã phải sơ tán người di dời đồ đạc ở một số địa bàn bị ngập nặng theo nhận định sơ bộ trận lũ ống khiến bốn bản của xã lượng minh bị thiệt hại nặng trong đó một bản thiệt hại nặng nhất là bản đứa."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000008", "start_ms": 98000, "end_ms": 113300, "text": "lũ cũng khiến tuyến đường huyết mạch từ bản xúc mạt đi trầm cuông đường vào bản minh tiến sạt lở nghiêm trọng tắc đường việc đó khiến công tác tiếp cận xử lý sau trận lũ ống gặp khó khăn đến sáng nay người dân và chính quyền vẫn đang nỗ lực khắc phục hậu quả trận lũ ống và thống kê thiệt hại."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000009", "start_ms": 114300, "end_ms": 131600, "text": "trong khi đó do ảnh hưởng của các đợt mưa lớn đã làm rạn nứt sụt lún và sạt lở đất đồi tại khu phố na khà và chiêm tục thị trấn mường lát tỉnh theng hoá sạt lở đã uy hiếp sự an toàn của hai mươi lăm hộ dân sống tại các khu phố này chính quyền địa phương đã tổ chức sơ tán khẩn cấp các hộ dân đến nơi an toàn."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000010", "start_ms": 133200, "end_ms": 150200, "text": "công tác khắc phục hậu quả thiên tai sạt lở đất tại huyện bắc quan hà giang vẫn đang được các lực lượng chức năng lực lượng tại chỗ khẩn trương tiến hành cùng với đó công tác đảm bảo hậu cần cũng đang được thực hiện đi gửi những phần cơm đầy đủ dinh dưỡng đến lực lượng cứu nạn cứu hộ người dân bị ảnh hưởng vì thiên tai trên địa bàn."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000011", "start_ms": 152700, "end_ms": 165500, "text": "trong cơn mưa tầm tã người dân đến từ các nhóm thiện nguyện tại thị trấn việt quang huyện bắc quang vẫn mỗi người một việc tất bật nấu cơm đóng gói và vận chuyển tới tay lực lượng cứu trợ và bà con bị ảnh hưởng vì thiên tai."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000012", "start_ms": 166000, "end_ms": 185900, "text": "tôi thì cũng có tuổi rồi cho nên là tôi cũng không đi đến cái hiện trường để ở tôi giúp đỡ mọi người được nên là tôi cũng chỉ biết góp công góp sức vào những cái bữa cơm mà hàng ngày để hỗ trợ mọi người thôi ạ chúng tôi đã nấu gần một nghìn suất cơm rồi trong a hai ngày và dự kiến ở điểm sạt lở mọi người xin nấu khoảng một tuần."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000013", "start_ms": 186000, "end_ms": 196000, "text": "nhiều hoạt động nhân ái khác cũng được người dân nhiều thôn xóm hưởng ứng góp phần hỗ trợ đồng bào ở các thôn thượng mỹ nậm buôn của xã việt vinh bị thiệt hại do mưa lũ sạt lở đất."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000014", "start_ms": 196200, "end_ms": 201900, "text": "qua đó thể hiện tinh thần nhường cơm sẻ áo không để ai bị bỏ lại phía sau trong cơn hoạn nạn."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000015", "start_ms": 203400, "end_ms": 218000, "text": "sáng nay hai mươi bốn học sinh trường tiểu học chương dương quận một thành phố hồ chí minh nghỉ học hôm qua sau sự việc cô giáo xin tiền hỗ trợ mua máy tính cá nhân đã quay trở lại trường nhà trường đã phân cô đinh thị kim thoa phó hiệu trưởng nhà trường đảm nhận nhiệm vụ phụ trách lớp bốn ba."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000016", "start_ms": 220100, "end_ms": 231700, "text": "quan sát giờ học của các con sau khi trở lại trường các phụ huynh lớp bốn ba đã cảm thấy yên tâm phần nào với cách xử lý của trường và phòng giáo dục đào tạo quận một lớp học hiện chỉ vắng hai em do bị bệnh."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000017", "start_ms": 232100, "end_ms": 239200, "text": "giáo viên chủ nhiệm mới đảm nhiệm lớp với một cái tiết học làm cho các con có vẻ là thích thú rất yên tâm."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000018", "start_ms": 239600, "end_ms": 243100, "text": "à yên tâm bởi vì à các a cơ quan ban ngành."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000019", "start_ms": 243400, "end_ms": 245900, "text": "đã quan tâm sâu sát đến người dân chúng tôi."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000020", "start_ms": 246300, "end_ms": 257700, "text": "chia sẻ thông tin về vụ việc cô giáo xin tiền phụ huynh để mua laptop phòng giáo dục đào tạo quận một khẳng định không bao che cho các hành vi vi phạm đồng thời công khai minh bạch làm rõ thông tin dư luận."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000021", "start_ms": 257900, "end_ms": 270000, "text": "ủy ban dân quận một đã giao cho phòng tài chính kế hoạch phòng giáo dục đào tạo cùng phối hợp với các đơn vị để kịp thời tham mưu việc kiểm tra thu chi đầu năm học ở các thị trường trên cái địa bàn."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000022", "start_ms": 270200, "end_ms": 281400, "text": "thời gian sắp tới phòng giáo dục đào tạo sẽ phân công nhân sự theo dõi những vấn đề của các cơ sở giáo dục trên địa bàn để kịp thời tháo gỡ các vướng mắc khó khăn cũng như xử lý các vấn đề phát sinh."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000023", "start_ms": 282800, "end_ms": 308700, "text": "khu đô thị bình quới thanh đa có tổng diện tích là bốn trăm hai mươi bảy héc ta được thành phố hồ chí minh phê duyệt và kêu gọi đầu tư từ năm một ngàn chín trăm chín mươi hai thế nhưng hơn ba mươi năm qua dự án vẫn chưa được triển khai vì nhiều lý do dự án khu đô thị bình quới thanh đa đã được đưa vào danh mục các dự án tiêu biểu cấp thành phố thi đua chào mừng kỷ niệm năm mươi năm ngày giải phóng miền nam thống nhất đất nước đây được xem là động thái khả quan khởi động lại dự án có ý nghĩa lớn của thành phố hồ chí minh."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000024", "start_ms": 310900, "end_ms": 320200, "text": "việc dự án đô thị bình quấy thanh đa đình trệ đã ảnh hưởng đến cuộc sống của hàng ngàn người dân sinh sống tại bán đảo thanh đa có đất rồi muốn tách thửa cho con là không được."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000025", "start_ms": 320400, "end_ms": 342200, "text": "mới đây thành phố hồ chí minh đã tổ chức cuộc thi tuyển quốc tế về ý tưởng quy hoạch và kiến trúc cho bán đảo bình quới thành đa nhằm biến nơi này thành một khu đô thị sinh thái hiện đại làm sao vừa giữ được một cái không gian đô thị mà xanh sạch rồi thích ứng biến đổi khí hậu mà lại là một cái nơi mà mọi người dân có thể tiếp cận được thứ nhất là đáp ứng được cái nhu cầu cái lợi ích của người dân."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000026", "start_ms": 342700, "end_ms": 345500, "text": "cái thứ hai là giúp cho địa phương phát triển."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000027", "start_ms": 345700, "end_ms": 349000, "text": "kinh tế văn hoá xã hội trong thời gian tới."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000028", "start_ms": 349200, "end_ms": 357100, "text": "đó là khâu tổ chức bồi thường giải phóng mặt bằng và tái định cư cho bà con cái thứ hai nữa tạo được cái thu nhập cho bà con."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000029", "start_ms": 357400, "end_ms": 370300, "text": "một trong những yêu cầu quan trọng đối với quy hoạch dự án là đảm bảo dành ít nhất hai trăm héc ta cho công viên cây xanh kết nối hài hoà với cảnh quan sông sài gòn mang đến không gian vui chơi giải trí và tham quan cho người dân."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000030", "start_ms": 371800, "end_ms": 386100, "text": "sáng nay sở du lịch tỉnh khánh hòa phối hợp với cảng hàng không quốc tế cam ranh tổ chức lễ đón vị khách du lịch thứ chín triệu đến với nhà trà khánh hòa đây là sự kiện đặc biệt quan trọng đánh dấu mức tăng trưởng ấn tượng khi chỉ trong chín tháng khánh hòa đã hoàn thành các chỉ tiêu du lịch của cả năm."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000031", "start_ms": 388600, "end_ms": 399500, "text": "máy bay được chào đón bằng nghi thức phun vòi rồng chào mừng vị khách thứ chín triệu đến khánh hòa là bà an rin dong đi trên chuyến bay của hãng hàng không việt nam ai lai từ incheon hàn quốc."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000032", "start_ms": 400500, "end_ms": 409800, "text": "tôi rất vui và bất ngờ khi biết mình là vị khách thứ chín triệu đây là lần đầu tiên tôi đến nhà trang khánh hòa thật tuyệt vời xin cám ơn vì đã chào đón chúng tôi nồng nhiệt như thế này."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000033", "start_ms": 410700, "end_ms": 420500, "text": "thông qua sự kiện ngành du lịch khánh hòa mong muốn lan toả hình ảnh nhà tràng khánh hòa thân thiện bến khách và mục tiêu trở thành một trong những điểm đến hàng đầu đông nam á."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000034", "start_ms": 420900, "end_ms": 431500, "text": "tính đến hết tháng chín năm nay tổng lực khách lưu trú đến khánh hòa ước đạt chín triệu lượt tăng khoảng năm mươi tám phần trăm so với cùng kỳ trong đó khách quốc tế tăng đến một trăm bốn mươi tám phần trăm."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000035", "start_ms": 431600, "end_ms": 446500, "text": "ngày mười ba tháng mười tỉnh khánh hòa sẽ phát động chương trình kích cầu du lịch với chủ đề du lịch nha trang khánh hòa đến để yêu với nhiều chương trình giảm giá khuyến mãi đồng loạt tại các doanh nghiệp lưu trú kinh doanh dịch vụ du lịch trong ba tháng cuối năm."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000036", "start_ms": 447500, "end_ms": 449600, "text": "thế giới trong ngày có gì."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000037", "start_ms": 450900, "end_ms": 455100, "text": "malaysia công bố kế hoạch thúc đẩy việc sử dụng trí tuệ nhân tạo ai."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000038", "start_ms": 458000, "end_ms": 462900, "text": "hàng chục thí sinh tham dự cuộc thi ăn ớt cây khét tiếng có tên mười loại ớt cây cực độ."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000039", "start_ms": 467800, "end_ms": 478200, "text": "chiều nay ông shigeru ishiba chính thức được bầu làm thủ tướng nhật bản sau cuộc bỏ phiếu tại quốc hội trước đó ông đã giành chiến thắng trong cuộc đua lãnh đạo của đảng dân chủ tự do eo đi pi."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000040", "start_ms": 480200, "end_ms": 491300, "text": "tân thủ tướng shigeru ishiba sáu mươi bảy tuổi là thủ tướng thứ một trăm linh hai của nhật bản ông từng giữ chức bộ trưởng quốc phòng và giờ sẽ thay thế vị trí của ông sumio kishida."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000041", "start_ms": 491600, "end_ms": 501300, "text": "sau khi được nhật hoàng chính thức bổ nhiệm trong buổi lễ tại hoàng cung tô ki ô ông i shi ba dự kiến sẽ tổ chức họp báo vào cuối ngày hôm nay và công bố các thành viên nội các mới."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000042", "start_ms": 501600, "end_ms": 518800, "text": "ông cho biết mình đang hướng đến hàn gắn những chi rẻ trong nội bộ đảng e lờ đê bê và chuẩn bị cho cuộc bầu cử ngày hai mươi bảy tháng mười trong nhiệm kỳ mới tân thủ tướng sẽ đối mặt với việc giải quyết các vấn đề đang được quan tâm như chi phí sinh hoạt tăng hay tình hình an ninh đang nóng lên ở khu vực đông á."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000043", "start_ms": 520300, "end_ms": 529200, "text": "malaysia hôm nay đã công bố kế hoạch xây dựng chính sách quốc gia về điện toán đám mây đồng thời thúc đẩy việc sử dụng trí tuệ nhân tạo ây ai một cách có trách nhiệm và đạo đức."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000044", "start_ms": 531300, "end_ms": 541200, "text": "tại sự kiện khởi công trung tâm dữ liệu và lưu trữ điện toán đám mây của google tại malaysia thủ tướng angwa ibrahim cho biết chính sách điện toán đám mây sẽ tập trung vào bốn lĩnh vực."}
{"video_id": "K01_V001", "seg_id": "K01_V001_000045", "start_ms": 541400, "end_ms": 543300, "text": "đổi mới và hiệu quả dịch vụ công."}
