# Server vLLM riêng, độc lập với image so sánh (Dockerfile) -- vllm kéo theo
# một bộ dependency CUDA/torch khác hẳn paddle+bitsandbytes, gộp chung dễ vỡ.
#
# GPU ở host này là RTX 2080Ti (Turing, compute capability 7.5): vLLM chỉ
# chấp nhận bfloat16 từ compute capability 8.0 trở lên, nên server phải chạy
# --dtype float16 (xem run_vllm.sh).
FROM vllm/vllm-openai:latest

# Kiến trúc qwen3_vl mới được đăng ký gần đây trên nhánh main của vllm --
# image release có thể chưa có, nâng cấp để chắc chắn nhận diện được model.
RUN pip install --no-cache-dir -U vllm

# Cụm dùng chung phân mảnh VRAM nặng (nhiều tiến trình nhỏ chiếm rải rác) --
# expandable_segments giảm OOM do phân mảnh, đúng gợi ý trong log lỗi
# torch.OutOfMemoryError đã gặp khi NF4 dequant cần cấp phát scratch buffer.
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
